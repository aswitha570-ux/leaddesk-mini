# Copy this file to .env and fill in real values before running locally.
# On Render, you'll set these same keys in the Environment tab (no .env file needed there).

# Any random long string - used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string

# Admin login credentials (used to seed the admin account on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

PORT=3000
